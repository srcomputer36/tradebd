AddType text/plain .ts .tsx .txt
AddType application/xml .xml
AddType application/json .json
AddType text/javascript .js .mjs
AddType text/css .css

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block direct access to internal blog storage & admin password hash files
  RewriteRule ^(\.tradebd-admin-hash\.php|blogs-data\.json)$ - [F,L]

  # Do not rewrite existing files (sitemap.xml, robots.txt, llms.txt, ai-catalog.json, api-blogs.php, google*.html), assets, or API routes
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^llms\.txt$ - [L]
  RewriteRule ^ai-catalog\.json$ - [L]
  RewriteRule ^api-blogs\.php$ - [L]
  RewriteRule ^google[a-z0-9]+\.html$ - [L]
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/src/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
