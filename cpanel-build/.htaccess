AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .mjs .xml .json .txt .svg .webmanifest

AddType text/html .html
AddType text/plain .ts .tsx .txt
AddType application/xml .xml
AddType application/json .json
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
AddType text/css .css
AddType image/svg+xml .svg
AddType image/png .png
AddType image/x-icon .ico

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force 301 Permanent Redirect from www.tradebd.online and HTTP to https://tradebd.online
  RewriteCond %{HTTP_HOST} ^www\.tradebd\.online$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(?:www\.)?tradebd\.online$ [NC]
  RewriteRule ^(.*)$ https://tradebd.online/$1 [L,R=301]

  # Normalize trailing slash on sub-routes to match canonical URLs (301 redirect)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://tradebd.online/$1 [L,R=301]

  # Block direct access to internal blog storage & admin password hash files
  RewriteRule ^(\.tradebd-admin-hash\.php|blogs-data\.json)$ - [F,L]

  # Serve .well-known/ai-catalog.json from root ai-catalog.json if .well-known folder is not present
  RewriteRule ^\.well-known/ai-catalog\.json$ /ai-catalog.json [L]

  # Allow internal delivery of pre-rendered static route HTML files
  RewriteRule ^prerender/.*\.html$ - [L]

  # Serve pre-rendered static SEO HTML for each route in sitemap.xml (HTTP 200 with unique canonical tag)
  RewriteCond %{DOCUMENT_ROOT}/prerender/$1.html -f
  RewriteRule ^([a-zA-Z0-9\-_/]+?)/?$ /prerender/$1.html [L]

  # Do not rewrite existing SEO, icon, manifest, or API files
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^llms\.txt$ - [L]
  RewriteRule ^ai-catalog\.json$ - [L]
  RewriteRule ^site\.webmanifest$ - [L]
  RewriteRule ^favicon\.(ico|svg)$ - [L]
  RewriteRule ^apple-touch-icon\.png$ - [L]
  RewriteRule ^logo\.svg$ - [L]
  RewriteRule ^og-banner\.(png|svg)$ - [L]
  RewriteRule ^api-blogs\.php$ - [L]
  RewriteRule ^google[a-z0-9]+\.html$ - [L]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/src/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|htm)$">
    Header set Content-Type "text/html; charset=UTF-8"
  </FilesMatch>
  <FilesMatch "^(llms\.txt|ai-catalog\.json)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
